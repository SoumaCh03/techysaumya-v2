# ── MongoDB Atlas ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/database

# ── Admin Credentials (Seeded on first startup) ───────────────
ADMIN_USERNAME=admin_sa
ADMIN_PASSWORD=strong_admin_password_here
ADMIN_RECOVERY_EMAIL=recovery@example.com

# ── Gmail SMTP / Mail Transporter Configuration ───────────────
SMTP_EMAIL_HOST=smtp.gmail.com
SMTP_EMAIL_PORT=587
SMTP_EMAIL_USER=your-email@gmail.com
SMTP_EMAIL_PASS=your-app-specific-password-here

# ── Cloudinary Media CDN Configuration ────────────────────────
CLOUDINARY_CLOUD_NAME=cloudinary_cloud_name_here
CLOUDINARY_API_KEY=cloudinary_api_key_here
CLOUDINARY_API_SECRET=cloudinary_api_secret_here

# ── Site Domain URL ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://saumyadeepch.vercel.app
